{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python system/hooks/autonomy_guard.py --cursor-native --harness cursor",
        "timeout": 15
      },
      {
        "command": "python system/hooks/board_guard.py --cursor-native --event sessionstart --harness cursor",
        "timeout": 15
      },
      {
        "command": "python system/hooks/index_refresh.py --cursor-native --harness cursor",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "python system/hooks/board_guard.py --cursor-native --event stop --harness cursor",
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write|Delete",
        "command": "python system/hooks/version_guard.py --cursor-native",
        "timeout": 15
      },
      {
        "matcher": "Write|Delete",
        "command": "python system/hooks/board_guard.py --cursor-native --event pretooluse --harness cursor",
        "timeout": 15
      },
      {
        "matcher": "update_draft",
        "command": "python system/hooks/publish_guard.py --cursor-native",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "matcher": "project_manager\\.py|svg_to_pptx\\.py|confirm_ui[\\\\/]server\\.py",
        "command": "python system/hooks/ppt_master_guard.py --cursor-native --harness cursor",
        "timeout": 15
      },
      {
        "matcher": "af\\.py",
        "command": "python system/hooks/voice_guard.py --cursor-native --harness cursor",
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "matcher": "Shell",
        "command": "python system/hooks/ppt_master_guard.py --cursor-native --harness cursor",
        "timeout": 15
      },
      {
        "matcher": "Shell",
        "command": "python system/hooks/voice_guard.py --cursor-native --harness cursor",
        "timeout": 20
      }
    ]
  }
}
