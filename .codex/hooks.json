{
  "description": "AgentFrame guards for bounded autonomy, versioned artifacts, and PPT Master workflows.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/autonomy_guard.py\" --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/autonomy_guard.py\" --harness codex",
            "timeout": 15,
            "statusMessage": "Loading bounded autonomy contract"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/board_guard.py\" --event sessionstart --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/board_guard.py\" --event sessionstart --harness codex",
            "timeout": 15,
            "statusMessage": "Syncing the AgentFrame board"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/index_refresh.py\" --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/index_refresh.py\" --harness codex",
            "timeout": 15,
            "statusMessage": "Refreshing the retrieval index"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/board_guard.py\" --event stop --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/board_guard.py\" --event stop --harness codex",
            "timeout": 15,
            "statusMessage": "Recording the AgentFrame board receipt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Delete|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/version_guard.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/version_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking AgentFrame version safety"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/board_guard.py\" --event pretooluse --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/board_guard.py\" --event pretooluse --harness codex",
            "timeout": 15,
            "statusMessage": "Checking the AgentFrame board boundary"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/ppt_master_guard.py\" --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/ppt_master_guard.py\" --harness codex",
            "timeout": 15,
            "statusMessage": "Checking AgentFrame PPT safety"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/voice_guard.py\" --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/voice_guard.py\" --harness codex",
            "timeout": 20,
            "statusMessage": "Checking the AgentFrame voice lint"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/ppt_master_guard.py\" --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/ppt_master_guard.py\" --harness codex",
            "timeout": 15,
            "statusMessage": "Checking AgentFrame PPT follow-through"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/voice_guard.py\" --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/voice_guard.py\" --harness codex",
            "timeout": 20,
            "statusMessage": "Reporting the AgentFrame voice lint"
          }
        ]
      }
    ]
  }
}
