# === Secrets ===
.env
.env.local

# === Operator content (PII, private) ===
# The public shapes of these files live in library/schema/ (tracked).
library/context/
system/*backlog*.md

# === Operator visual assets (client logos, brand design languages) ===
# The schema (README.md) travels; the instances are client-identifiable and never do.
library/assets/design-languages/*
!library/assets/design-languages/.gitkeep
library/assets/logos/*
!library/assets/logos/.gitkeep
# The operator's own captures and licensed audio: card schema travels, instances never do.
library/assets/media/*
!library/assets/media/.gitkeep
library/assets/audio/*
!library/assets/audio/.gitkeep

# === Local model weights (fetched on first use; never committed) ===
system/models/*
!system/models/README.md

# === Operator layer: life, projects, pipeline, studio (private; its own git repo, no remote) ===
workspace/

# === Runtime / generated state ===
system/logs/

# === Retrieval index (derived cache, per-machine; never truth) ===
system/index/vault.db
system/index/vault.db-shm
system/index/vault.db-wal
system/index/golden-set.yaml
system/index/voice/
system/index/refresh.log

# === Scratch directories anywhere in the tree ===
**/_scratch/

# === Exported deliverable binaries (regenerable from markdown sources) ===
workspace/**/*.docx
workspace/**/*.pptx

# === OS / editor cruft ===
Thumbs.db
.DS_Store
*.swp
.vscode/
.idea/

# === Python bytecode caches ===
__pycache__/
*.pyc
*.pyo

# === Claude Code local config ===
# Ignore local plans, settings, and worktrees while re-including the shared
# hook wiring and the AgentFrame-owned skills Claude discovers natively.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/skills/**

# === Plugin scratch (brainstorming / writing-plans design specs) ===
docs/
# system/docs/ is not scratch: it is the vendored PPT Master documentation
# dependency (system/vendor/ppt-master/VENDOR.md). Already-tracked files were
# grandfathered in, but new ones a vendor refresh brings must not be ignored.
!system/docs/
!system/docs/**
