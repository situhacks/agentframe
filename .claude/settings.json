{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/autonomy_guard.py\" --harness claude"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/board_guard.py\" --event sessionstart --harness claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/board_guard.py\" --event stop --harness claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Delete",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/version_guard.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/board_guard.py\" --event pretooluse --harness claude"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/ppt_master_guard.py\" --harness claude"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/voice_guard.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "mcp__substack__update_draft",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/publish_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/ppt_master_guard.py\" --harness claude"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/system/hooks/voice_guard.py\" --harness claude"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
