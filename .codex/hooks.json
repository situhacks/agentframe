{
  "description": "AgentFrame guards for bounded autonomy, versioned artifacts, and PPT Master workflows.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/autonomy_guard.py\" --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/autonomy_guard.py\" --harness codex",
            "timeout": 15,
            "statusMessage": "Loading bounded autonomy contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Delete|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/version_guard.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/version_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking AgentFrame version safety"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/ppt_master_guard.py\" --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/ppt_master_guard.py\" --harness codex",
            "timeout": 15,
            "statusMessage": "Checking AgentFrame PPT safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/system/hooks/ppt_master_guard.py\" --harness codex",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/system/hooks/ppt_master_guard.py\" --harness codex",
            "timeout": 15,
            "statusMessage": "Checking AgentFrame PPT follow-through"
          }
        ]
      }
    ]
  }
}
