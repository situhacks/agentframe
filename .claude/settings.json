{
  "permissions": {
    "deny": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "agent_completed|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook notification"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook pre-tool-use"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook pre-tool-use"
          }
        ]
      },
      {
        "matcher": "mcp__substack__update_draft",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook post-tool-use"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
