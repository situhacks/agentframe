# === Secrets ===
.env
.env.local

# === Operator content (PII / private to this fork) ===
library/context/*
!library/context/_meta/
!library/context/operator-schema/
system/builder-backlog*.md

# === Private source-backed lenses ===
library/lenses/*
!library/lenses/README.md

# === Operator visual assets (client logos, brand design languages) ===
# The schema (README.md) travels; the instances are client-identifiable and never do.
library/assets/design-languages/*
!library/assets/design-languages/.gitkeep
library/assets/logos/*
!library/assets/logos/.gitkeep

# === Operator projects ===
workspace/projects/*
!workspace/projects/.gitkeep
!workspace/projects/completed/
workspace/projects/completed/*
!workspace/projects/completed/.gitkeep

# === Operator pipeline (careers) ===
workspace/pipeline/*
!workspace/pipeline/.gitkeep

# === Operator research ===
workspace/research/

# === Runtime / generated state ===
system/logs/
system/audit/*.db
system/audit/*.db-shm
system/audit/*.db-wal

# === Retrieval index (derived cache, per-machine; never truth) ===
system/index/vault.db
system/index/vault.db-shm
system/index/vault.db-wal
system/index/golden-set.yaml

# === Browser harness runtime ===
system/browser/runs/
system/browser/workflows/**/runs/
system/browser/cache/
system/browser/local/
system/browser/node_modules/
system/browser/dist/
system/browser/.env

# === Open Design local runtime / build artifacts ===
system/skills/open-design/source/node_modules/
system/skills/open-design/source/.od/
system/skills/open-design/source/.od-e2e/
system/skills/open-design/source/dist/
system/skills/open-design/source/out/
system/skills/open-design/source/.next/
system/skills/open-design/source/.next-*/
system/skills/open-design/source/.tmp/
system/skills/open-design/source/test-results/
system/skills/open-design/source/playwright-report/
system/skills/open-design/source/e2e/.od-data/
system/skills/open-design/source/e2e/reports/

# === Open Design — operator content under the source subtree ===
# gitignore only affects UNTRACKED paths, so upstream-shipped systems/skills
# (already tracked) stay; anything new the operator adds here stays local.
system/skills/open-design/source/design-systems/*/
system/skills/open-design/source/skills/*/

# === Scratch directories anywhere in the tree ===
**/_scratch/

# === Exported deliverable binaries (regenerable from markdown sources) ===
workspace/**/*.docx
workspace/**/*.pptx

# === OS / editor cruft ===
Thumbs.db
.DS_Store
*.swp
.vscode/
.idea/

# === Python bytecode caches ===
__pycache__/
*.pyc
*.pyo

# === Harness-local config with narrow tracked AgentFrame integrations ===
# Ignore each directory's local plans/settings while re-including only the
# shared hook wiring and generated skill projections AgentFrame owns.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/skills/**
.cursor/*
!.cursor/hooks.json
!.cursor/skills/
!.cursor/skills/**
.codex/*
!.codex/hooks.json

# === Plugin scratch (brainstorming / writing-plans design specs) ===
docs/
# system/docs/ is not scratch: it is the vendored PPT Master documentation
# dependency (system/skills/ppt-master/VENDOR.md). Already-tracked files were
# grandfathered in, but new ones a vendor refresh brings must not be ignored.
!system/docs/
!system/docs/**

# === Local surface runtime state (per-machine) ===
system/server/.surface.lock
system/server/.surface.log
system/server/.cache/

# === Managed automation deployment state (per-machine) ===
system/daemon/local/
