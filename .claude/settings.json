{
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "agent_completed|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook notification"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook pre-tool-use"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook pre-tool-use"
          }
        ]
      },
      {
        "matcher": "mcp__substack__update_draft",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AF_ROOT=\"${CLAUDE_PROJECT_DIR}\" af hook pre-compact",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
